<%- include('_header') %>
<h1 class="text-2xl font-bold">Creative enquiries</h1>
<p class="mt-3 text-slate-600"><%= total %> enquiries from the Designer &amp; Video Editor explainer page. Information only; no payment collected.</p>
<div class="mt-8 space-y-5">
<% items.forEach(entry => { %>
  <article class="rounded-xl border border-slate-200 bg-white p-6">
    <div class="flex flex-wrap justify-between gap-3"><h2 class="text-lg font-bold"><%= entry.name %> · <%= entry.company %></h2><span class="text-sm text-slate-500">#<%= entry.id %> · <%= entry.created_at %> UTC</span></div>
    <p class="mt-2"><%= entry.email %> · <%= entry.phone %></p>
    <p class="mt-2 font-medium"><%= entry.service_type %></p>
    <p class="mt-4 whitespace-pre-wrap break-words text-slate-700"><%= entry.requirement_note %></p>
  </article>
<% }) %>
<% if (!items.length) { %><p class="py-12 text-slate-500">No creative enquiries yet.</p><% } %>
</div>
<nav aria-label="Enquiry pages" class="mt-8 flex gap-5 items-center">
  <% if (page > 1) { %><a href="?page=<%= page - 1 %>" class="underline">Previous</a><% } %>
  <span>Page <%= page %> of <%= pageCount %></span>
  <% if (page < pageCount) { %><a href="?page=<%= page + 1 %>" class="underline">Next</a><% } %>
</nav>
<%- include('_footer') %>
