<%- include('_header', { admin, title: 'Subscription request #' + entry.id + ' — UpSquad Admin' }) %>
<a href="/admin/subscription-requests" class="text-sm text-emerald-700 hover:underline">← All subscriptions</a>
<div class="mt-5 mb-6"><h1 class="text-2xl font-bold">Subscription request #<%= entry.id %></h1><p class="mt-2 text-sm text-slate-500">Accountant subscription · Submitted <%= date(entry.created_at) %> IST</p></div>
<% if (refreshed) { %><p role="status" class="mb-5 rounded-lg bg-emerald-50 border border-emerald-200 p-4 text-sm text-emerald-800">Payment status checked with Cashfree.</p><% } %>
<% if (error) { %><p role="alert" class="mb-5 rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-800">Cashfree could not be reached. The saved payment status is unchanged. Please try again.</p><% } %>
<div class="grid md:grid-cols-2 gap-6">
  <section class="bg-white border border-gray-200 rounded-xl p-6">
    <h2 class="text-lg font-semibold">Contact details</h2>
    <dl class="mt-5 space-y-5"><% [['Contact person name', entry.name], ['Business name', entry.company], ['Email', entry.email], ['Phone number', entry.phone]].forEach(function(field) { %><div><dt class="text-sm text-slate-500"><%= field[0] %></dt><dd class="mt-1 font-medium break-words"><%= field[1] || '—' %></dd></div><% }) %></dl>
  </section>
  <section class="bg-white border border-gray-200 rounded-xl p-6">
    <h2 class="text-lg font-semibold">Payment details</h2>
    <dl class="mt-5 space-y-5">
      <div><dt class="text-sm text-slate-500">Payment status</dt><dd class="mt-1 font-semibold <%= entry.payment_status === 'paid' ? 'text-emerald-700' : 'text-slate-700' %>"><%= statuses[entry.payment_status || 'not_started'] || entry.payment_status %></dd></div>
      <div><dt class="text-sm text-slate-500">Amount</dt><dd class="mt-1 font-medium"><%= entry.payment_amount == null ? 'No checkout started' : money(entry.payment_amount) %></dd></div>
      <% if (entry.payment_reference) { %>
        <div><dt class="text-sm text-slate-500">Payment gateway</dt><dd class="mt-1 font-medium">Cashfree</dd></div>
        <div><dt class="text-sm text-slate-500">Payment reference / Cashfree link ID</dt><dd class="mt-1 font-mono text-xs break-all"><%= entry.payment_reference %></dd></div>
        <div><dt class="text-sm text-slate-500">Paid at (IST)</dt><dd class="mt-1 font-medium"><%= date(entry.paid_at) %></dd></div>
      <% } %>
    </dl>
    <% if (entry.payment_reference) { %>
      <form method="POST" action="/admin/subscription-requests/<%= entry.id %>/refresh-payment" class="mt-6"><input type="hidden" name="csrf" value="<%= csrf %>" /><button class="rounded-lg bg-slate-900 text-white px-5 py-3 text-sm font-medium">Check Cashfree payment status</button></form>
      <p class="mt-3 text-xs text-slate-500">Paid status is confirmed by Cashfree. This action does not charge the customer.</p>
    <% } %>
  </section>
</div>
<%- include('_footer') %>
