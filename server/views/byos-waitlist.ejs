<%- include('_header', { admin, title: 'BYOS waiting list — UpSquad Admin' }) %>
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">BYOS waiting list</h1>
    <p class="text-sm text-slate-500 mt-1">People who joined the waiting list from the BYOS landing page. <%= total %> total.</p>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-slate-500 text-xs uppercase">
      <tr>
        <th class="text-left px-4 py-3">When</th>
        <th class="text-left px-4 py-3">Name</th>
        <th class="text-left px-4 py-3">Business</th>
        <th class="text-left px-4 py-3">Plan</th>
        <th class="text-left px-4 py-3">Contact</th>
        <th class="text-left px-4 py-3">Note</th>
        <th class="text-left px-4 py-3">Status</th>
      </tr>
    </thead>
    <tbody>
      <% if (entries.length === 0) { %>
        <tr><td colspan="7" class="px-4 py-6 text-center text-slate-500">No one on the waiting list yet.</td></tr>
      <% } %>
      <% entries.forEach(function(e) { %>
        <tr class="border-t border-gray-100 align-top">
          <td class="px-4 py-3 text-xs text-slate-500 whitespace-nowrap"><%= e.created_at %></td>
          <td class="px-4 py-3 font-medium"><%= e.name %></td>
          <td class="px-4 py-3"><%= e.business || '—' %></td>
          <td class="px-4 py-3 capitalize"><%= e.plan %></td>
          <td class="px-4 py-3">
            <a href="mailto:<%= e.email %>" class="text-emerald-600 hover:underline"><%= e.email %></a><br>
            <a href="https://wa.me/<%= String(e.phone).replace(/\D/g, '') %>" target="_blank" rel="noopener" class="text-slate-600 hover:underline"><%= e.phone %></a>
          </td>
          <td class="px-4 py-3 text-slate-600 max-w-xs whitespace-pre-line"><%= e.note || '—' %></td>
          <td class="px-4 py-3"><span class="inline-block px-2 py-0.5 rounded-full text-xs bg-gray-100 text-slate-700"><%= e.status %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('_footer') %>
