<%- include('_header', { admin, title: 'Subscriptions — UpSquad Admin' }) %>
<div class="mb-6">
  <h1 class="text-2xl font-bold">Accountant subscriptions</h1>
  <p class="mt-2 text-sm text-slate-500">Contact details submitted from the accountant subscription form, including incomplete checkouts. All times are IST.</p>
</div>
<div class="grid sm:grid-cols-3 gap-4 mb-6">
  <% [['Submissions', total], ['Paid subscriptions', paid_count], ['Payments received', money(paid_amount)]].forEach(function(stat) { %>
    <div class="bg-white border border-gray-200 rounded-xl p-5"><p class="text-sm text-slate-500"><%= stat[0] %></p><p class="mt-2 text-2xl font-bold"><%= stat[1] %></p></div>
  <% }) %>
</div>
<form method="GET" action="/admin/subscription-requests" class="flex flex-wrap gap-3 items-end mb-5">
  <label class="flex-1 min-w-48 text-sm"><span class="block mb-1 font-medium">Search contacts</span><input type="search" name="search" value="<%= search %>" placeholder="Name, business, email or phone" maxlength="254" class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5" /></label>
  <label class="text-sm"><span class="block mb-1 font-medium">Payment status</span><select name="paymentStatus" class="rounded-lg border border-gray-300 bg-white px-3 py-2.5"><option value="">All statuses</option><% Object.entries(statuses).forEach(function([value, label]) { %><option value="<%= value %>" <%= paymentStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
  <button class="rounded-lg bg-slate-900 text-white px-5 py-2.5 text-sm font-medium">Apply filters</button>
  <% if (search || paymentStatus) { %><a href="/admin/subscription-requests" class="px-2 py-2.5 text-sm underline">Clear</a><% } %>
</form>
<p class="text-xs text-slate-500 mb-3">Totals reflect the current filters. Payment status is saved after Cashfree verification; open a request to check it again.</p>
<div class="bg-white border border-gray-200 rounded-xl overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-slate-500 text-xs uppercase"><tr><th class="text-left px-4 py-3">Submitted (IST)</th><th class="text-left px-4 py-3">Contact person / business</th><th class="text-left px-4 py-3">Email / phone</th><th class="text-left px-4 py-3">Payment</th><th class="px-4 py-3"><span class="sr-only">Details</span></th></tr></thead>
    <tbody>
      <% if (!items.length) { %><tr><td colspan="5" class="px-4 py-12 text-center text-slate-500">No subscription requests found<%= search || paymentStatus ? ' for these filters' : ' yet' %>.</td></tr><% } %>
      <% items.forEach(function(entry) { %>
        <tr class="border-t border-gray-100 align-top">
          <td class="px-4 py-4 text-xs text-slate-500 whitespace-nowrap"><%= date(entry.created_at) %><div class="mt-1">#<%= entry.id %></div></td>
          <td class="px-4 py-4"><div class="font-semibold"><%= entry.name %></div><div class="mt-1 text-slate-500 break-words"><%= entry.company || '—' %></div></td>
          <td class="px-4 py-4"><a href="mailto:<%= entry.email %>" class="text-emerald-700 hover:underline break-all"><%= entry.email %></a><div class="mt-1"><a href="tel:<%= entry.phone.replace(/[^+\d]/g, '') %>" class="text-slate-600 hover:underline"><%= entry.phone %></a></div></td>
          <td class="px-4 py-4 whitespace-nowrap"><span class="inline-block px-2 py-1 rounded-full text-xs font-medium <%= entry.payment_status === 'paid' ? 'bg-emerald-100 text-emerald-800' : entry.payment_status === 'cancelled' ? 'bg-gray-100 text-slate-600' : 'bg-amber-50 text-amber-800' %>"><%= statuses[entry.payment_status || 'not_started'] || entry.payment_status %></span><div class="mt-2 font-medium"><%= entry.payment_amount == null ? '—' : money(entry.payment_amount) %></div></td>
          <td class="px-4 py-4 text-right"><a href="/admin/subscription-requests/<%= entry.id %>" aria-label="View request <%= entry.id %>" class="text-emerald-700 font-medium hover:underline">View details</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<nav aria-label="Submission pages" class="flex flex-wrap items-center justify-between gap-3 mt-5 text-sm text-slate-600">
  <span>Page <%= page %> of <%= pageCount %> · <%= total %> requests</span>
  <div class="flex gap-4"><% if (page > 1) { %><a href="<%= pageUrl(page - 1) %>" class="underline">Previous</a><% } %><% if (page < pageCount) { %><a href="<%= pageUrl(page + 1) %>" class="underline">Next</a><% } %></div>
</nav>
<%- include('_footer') %>
